<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mx5_bg">

    <com.mx5dash.obd2android.ui.Mx5RenderView
        android:id="@+id/renderView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/connStatusPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="6dp"
        android:background="@drawable/conn_pill_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:textColor="@color/mx5_dim"
        android:textSize="10sp"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone"
        android:text="@string/bt_disconnected" />

</FrameLayout>
